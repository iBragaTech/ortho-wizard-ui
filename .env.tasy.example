# Valores PUBLICOS para o build do portal; mesclar na configuracao existente.
# Cadastrar usuarios reais no Supabase Auth antes de ativar este modo.
VITE_PORTAL_AUTH_MODE=supabase
VITE_TASY_API_URL=https://api.exemplo.com.br
# O projeto ja usa VITE_SUPABASE_URL e VITE_SUPABASE_PUBLISHABLE_KEY.
# Nunca colocar ORACLE_PASSWORD, service_role ou chave secreta neste arquivo.
