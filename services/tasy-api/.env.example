# Copiar para .env SOMENTE no servidor da API. Nunca usar prefixo VITE_.
HOST=127.0.0.1
PORT=3100
PORTAL_ORIGIN=https://portal.exemplo.com.br

# Supabase Auth: usar o projeto correto e chave assimétrica (ES256 ou RS256).
AUTH_ISSUER=https://SEU-PROJETO.supabase.co/auth/v1
AUTH_AUDIENCE=authenticated
AUTH_JWKS_URL=https://SEU-PROJETO.supabase.co/auth/v1/.well-known/jwks.json
AUTH_ALGORITHM=ES256
TASY_PRINCIPALS_FILE=./principals.local.json

ORACLE_USER=PORTAL_TASY_LEITURA
# Use ORACLE_PASSWORD_ENCRYPTED with a key kept outside the repository.
ORACLE_PASSWORD_ENCRYPTED=
ORACLE_DECRYPTION_KEY_FILE=\\aeb-srvfshe\Departamentos_AEBMG\TI\Sistemas\Automacao\ortho-wizard-tasy.key
ORACLE_CONNECT_STRING=servidor-interno:1521/servico_homologacao
ORACLE_POOL_MAX=4
ORACLE_CALL_TIMEOUT_MS=10000
# Para modo Thick, instalar Oracle Instant Client e informar a pasta:
ORACLE_CLIENT_LIB_DIR=

# Escrita exige também operações homologadas e permissões explícitas.
TASY_WRITES_ENABLED=false
# Só habilitar após validar campos obrigatórios, triggers e regras do cadastro.
# A inclusão usa @SEQUENCE na trigger TASY.PESSOA_FISICA_INSERT.
# Depende também de inicialização homologada do contexto WHEB_USUARIO_PCK.
TASY_PESSOA_FISICA_DML_ENABLED=false
# Módulo local revisado pela TI; não aceitar esse caminho por HTTP.
TASY_OPERATIONS_FILE=
