# Backend independente. PGlite persiste PostgreSQL embutido para desenvolvimento.
PORTAL_DB_MODE=pglite
PORTAL_DATA_DIR=./.local/pgdata
HOST=127.0.0.1
PORT=3100
PORTAL_ORIGIN=http://localhost:5173
# Para o frontend publicado usar https://ortho-wizard-ui.lovable.app

# Modo postgres: banco NOVO exclusivo do portal; preencher somente no servidor.
# PORTAL_DB_MODE=postgres
# PGHOST=localhost
# PGPORT=5432
# PGDATABASE=ortho_wizard_portal
# PGUSER=portal_api
# PGPASSWORD=
# PGSSLMODE=verify-full
# PGSSLROOTCERT=C:/certificados/postgres-ca.pem

# Independente do Oracle para iniciar. Manter gravações desligadas na homologação.
TASY_ENABLED=false
TASY_WRITES_ENABLED=false
TASY_BUDGET_EXPORT_ENABLED=false
# Retorno de valores/status do Tasy. O comprovante tipo 1 aprova sozinho.
TASY_RETURN_SYNC_ENABLED=false
TASY_APPROVAL_RULE=document
TASY_PESSOA_FISICA_DML_ENABLED=false
TASY_PRINCIPALS_FILE=./principals.local.json
# Se habilitar Tasy, configurar ORACLE_* conforme .env.example.
